// =======================================================
// DIAGRAMA ENTIDAD-RELACIÓN - SISTEMA DE QUEJAS UAEQROO
// Para dbdiagram.io (DBML - Database Markup Language)
// =======================================================

// ─────────────────────────────────────────
// 1. IDENTIDAD Y ACCESO
// ─────────────────────────────────────────

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  azure_id varchar(255) [unique, null]
  user_type varchar(255) [null, note: 'Estudiante, Docente, Administrativo']
  is_active boolean [default: true]
  remember_token varchar(100) [null]
  created_at timestamp
  updated_at timestamp
}

Table user_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  phone varchar(15) [null]
  age integer [null]
  gender varchar(50) [null]
  sex varchar(50) [null]
  vulnerable_group varchar(100) [null]
  created_at timestamp
  updated_at timestamp
}

Table campus_user {
  campus_id bigint [not null]
  user_id bigint [not null]

  indexes {
    (campus_id, user_id) [pk]
  }
}

Table socialite_users {
  id bigint [pk, increment]
  user_id bigint [not null]
  provider varchar(50) [not null]
  provider_id varchar(255) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (provider, provider_id) [unique]
  }
}

Table roles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table model_has_roles {
  role_id bigint [not null]
  model_type varchar(255) [not null]
  model_id bigint [not null]

  indexes {
    (role_id, model_id, model_type) [pk]
  }
}

// ─────────────────────────────────────────
// 2. CATÁLOGOS INSTITUCIONALES (UQROO)
// ─────────────────────────────────────────

Table campuses {
  id bigint [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table academic_divisions {
  id bigint [pk, increment]
  campus_id bigint [not null]
  name varchar(255) [not null]
  acronym varchar(50) [null]
  created_at timestamp
  updated_at timestamp
}

Table educational_programs {
  id bigint [pk, increment]
  academic_division_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table departments {
  id bigint [pk, increment]
  campus_id bigint [null]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table subdepartments {
  id bigint [pk, increment]
  department_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table buildings {
  id bigint [pk, increment]
  campus_id bigint [not null]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table locations {
  id bigint [pk, increment]
  building_id bigint [not null]
  name varchar(255) [not null]
  type varchar(100) [null, note: 'Baño, Aula, Pasillo, etc.']
  created_at timestamp
  updated_at timestamp
}

Table statuses {
  id bigint [pk, increment]
  name varchar(100) [not null]
  color varchar(50) [not null]
  is_closed boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

// ─────────────────────────────────────────
// 3. NÚCLEO DE REPORTES / TICKETS
// ─────────────────────────────────────────

Table tickets {
  id bigint [pk, increment]
  folio varchar(100) [unique, not null]
  reporter_id bigint [not null]
  assigned_to_id bigint [null]
  ticket_group varchar(50) [not null, note: 'SGC, GENERO, INFRAESTRUCTURA']
  status_id bigint [not null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────────────────────────────────
// 4. DETALLES ESPECÍFICOS POR TIPO DE TICKET
// ─────────────────────────────────────────

Table ticket_sgc_details {
  id bigint [pk, increment]
  ticket_id bigint [not null, unique]
  user_type varchar(100) [null]
  reported_person_name varchar(255) [null]
  area_type varchar(50) [null]
  department_id bigint [null]
  subdepartment_id bigint [null]
  academic_division_id bigint [null]
  educational_program_id bigint [null]
  classification varchar(100) [not null, note: 'Queja, Sugerencia, Felicitación']
  description longtext [not null]
  extra_attributes text [null]
  created_at timestamp
  updated_at timestamp
}

Table ticket_infra_details {
  id bigint [pk, increment]
  ticket_id bigint [not null, unique]
  campus_id bigint [not null]
  building_id bigint [not null]
  location_id bigint [null]
  issue_type varchar(150) [not null, note: 'Falla Red, Limpieza, Mantenimiento, etc.']
  missing_supplies json [null]
  description longtext [null]
  extra_attributes text [null]
  created_at timestamp
  updated_at timestamp
}

Table ticket_gender_details {
  id bigint [pk, increment]
  ticket_id bigint [not null, unique]
  campus_id bigint [null]
  reported_person_name varchar(255) [null]
  reported_person_type varchar(100) [null, note: 'Estudiante, Docente, Administrativo, Externo']
  reported_person_details varchar(255) [null]
  department_id bigint [null]
  subdepartment_id bigint [null]
  academic_division_id bigint [null]
  educational_program_id bigint [null]
  building_id bigint [null]
  location_id bigint [null]
  manifestation_type varchar(150) [not null, note: 'Violencia, Acoso, Discriminación, etc.']
  chronological_narrative longtext [not null]
  extended_narrative longtext [null]
  has_evidence boolean [default: false]
  witnesses_details longtext [null]
  needs_psychological_support boolean [default: false]
  communicated_to json [null]
  communication_results longtext [null]
  extra_attributes text [null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────────────────────────────────
// 5. SEGUIMIENTO Y AUDITORÍA
// ─────────────────────────────────────────

Table ticket_comments {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  user_id bigint [not null]
  body longtext [not null]
  is_internal boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table ticket_attachments {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  ticket_comment_id bigint [null]
  user_id bigint [not null]
  file_path varchar(500) [not null]
  file_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table ticket_histories {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  user_id bigint [not null]
  action varchar(100) [not null]
  old_value varchar(255) [null]
  new_value varchar(255) [null]
  created_at timestamp
  updated_at timestamp
}

// ─────────────────────────────────────────
// 6. FORMULARIOS DINÁMICOS
// ─────────────────────────────────────────

Table dynamic_forms {
  id bigint [pk, increment]
  name varchar(100) [unique, not null]
  title varchar(255) [not null]
  description text [null]
  created_at timestamp
  updated_at timestamp
}

Table dynamic_form_steps {
  id bigint [pk, increment]
  dynamic_form_id bigint [not null]
  title varchar(255) [not null]
  description text [null]
  icon varchar(100) [null]
  sort_order integer [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table dynamic_form_fields {
  id bigint [pk, increment]
  dynamic_form_step_id bigint [not null]
  name varchar(100) [not null]
  label varchar(255) [not null]
  type varchar(100) [not null]
  options text [null]
  placeholder varchar(255) [null]
  helper_text varchar(255) [null]
  is_required boolean [default: false]
  is_active boolean [default: true]
  sort_order integer [default: 0]
  created_at timestamp
  updated_at timestamp
}

// ─────────────────────────────────────────
// RELACIONES (FOREIGN KEYS)
// ─────────────────────────────────────────

// Identidad
Ref: user_profiles.user_id - users.id [delete: cascade]
Ref: campus_user.campus_id > campuses.id [delete: cascade]
Ref: campus_user.user_id > users.id [delete: cascade]
Ref: socialite_users.user_id > users.id [delete: cascade]
Ref: model_has_roles.role_id > roles.id [delete: cascade]
Ref: model_has_roles.model_id > users.id [delete: cascade]

// Catálogos UQROO
Ref: academic_divisions.campus_id > campuses.id [delete: cascade]
Ref: educational_programs.academic_division_id > academic_divisions.id [delete: cascade]
Ref: departments.campus_id > campuses.id [delete: cascade]
Ref: subdepartments.department_id > departments.id [delete: cascade]
Ref: buildings.campus_id > campuses.id [delete: cascade]
Ref: locations.building_id > buildings.id [delete: cascade]

// Tickets
Ref: tickets.reporter_id > users.id [delete: cascade]
Ref: tickets.assigned_to_id > users.id [delete: set null]
Ref: tickets.status_id > statuses.id

// Detalles satélites
Ref: ticket_sgc_details.ticket_id - tickets.id [delete: cascade]
Ref: ticket_sgc_details.department_id > departments.id [delete: set null]
Ref: ticket_sgc_details.subdepartment_id > subdepartments.id [delete: set null]
Ref: ticket_sgc_details.academic_division_id > academic_divisions.id [delete: set null]
Ref: ticket_sgc_details.educational_program_id > educational_programs.id [delete: set null]

Ref: ticket_infra_details.ticket_id - tickets.id [delete: cascade]
Ref: ticket_infra_details.campus_id > campuses.id
Ref: ticket_infra_details.building_id > buildings.id
Ref: ticket_infra_details.location_id > locations.id [delete: set null]

Ref: ticket_gender_details.ticket_id - tickets.id [delete: cascade]
Ref: ticket_gender_details.campus_id > campuses.id [delete: set null]
Ref: ticket_gender_details.department_id > departments.id [delete: set null]
Ref: ticket_gender_details.subdepartment_id > subdepartments.id [delete: set null]
Ref: ticket_gender_details.academic_division_id > academic_divisions.id [delete: set null]
Ref: ticket_gender_details.educational_program_id > educational_programs.id [delete: set null]
Ref: ticket_gender_details.building_id > buildings.id [delete: set null]
Ref: ticket_gender_details.location_id > locations.id [delete: set null]

// Seguimiento
Ref: ticket_comments.ticket_id > tickets.id [delete: cascade]
Ref: ticket_comments.user_id > users.id
Ref: ticket_attachments.ticket_id > tickets.id [delete: cascade]
Ref: ticket_attachments.ticket_comment_id > ticket_comments.id [delete: set null]
Ref: ticket_attachments.user_id > users.id
Ref: ticket_histories.ticket_id > tickets.id [delete: cascade]
Ref: ticket_histories.user_id > users.id

// Formularios Dinámicos
Ref: dynamic_form_steps.dynamic_form_id > dynamic_forms.id [delete: cascade]
Ref: dynamic_form_fields.dynamic_form_step_id > dynamic_form_steps.id [delete: cascade]

// ─────────────────────────────────────────
// GRUPOS VISUALES (TABLE GROUPS)
// ─────────────────────────────────────────

TableGroup Identidad_Acceso {
  users
  user_profiles
  campus_user
  socialite_users
  roles
  model_has_roles
}

TableGroup Catalogos_Institucionales {
  campuses
  academic_divisions
  educational_programs
  departments
  subdepartments
  buildings
  locations
  statuses
}

TableGroup Gestion_Tickets {
  tickets
  ticket_sgc_details
  ticket_infra_details
  ticket_gender_details
}

TableGroup Seguimiento_Auditoria {
  ticket_comments
  ticket_attachments
  ticket_histories
}

TableGroup Formularios_Dinamicos {
  dynamic_forms
  dynamic_form_steps
  dynamic_form_fields
}
